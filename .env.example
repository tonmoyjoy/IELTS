# MongoDB — optional in development: if unset or unreachable, the app uses in-memory MongoDB (data lost on restart).
# Production: set a real URI (e.g. Atlas).
MONGODB_URI=

# JWT signing secret (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-string

# Public app URL used by deployment-safe same-origin checks.
# Example: https://your-project.vercel.app
APP_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional comma-separated list for custom domains / preview domains.
# ALLOWED_ORIGINS=https://your-project.vercel.app,https://www.your-domain.com

# Gemini: transcription + default evaluator
# Get a key from Google AI Studio. Gemini API has a free tier subject to Google's current limits.
GEMINI_API_KEY=

# POST /api/exam/analyze?stream=1 streams SSE after Gemini transcription (transcript, eval deltas, result)

# Optional: model overrides
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: use OpenAI for evaluation only
# AI_EVAL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EVAL_MODEL=gpt-4o-mini

# Optional: production-ready Redis rate limiting.
# If unset, the app falls back to in-memory limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: send verification/reset emails through Resend.
# If unset, the app returns development links and logs email HTML.
# RESEND_API_KEY=
# EMAIL_FROM=IELTS Practice Studio <onboarding@resend.dev>
