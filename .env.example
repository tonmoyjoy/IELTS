# Copy to .env.local for `npm run dev`, or .env for `docker compose up`.
# In production the app validates these on first request and refuses to run
# with missing or weak values (see src/server/env.ts).

# --- Required in production -------------------------------------------------

# MongoDB connection string. In development, leave empty to use a throwaway
# in-memory database (data is lost on restart).
MONGODB_URI=

# Session signing secret. Production requires 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Canonical public URL. Used in email links, the CSRF origin allowlist and to
# decide whether cookies are Secure. Example: https://practice.example.com
APP_URL=http://localhost:3000

# Transactional email (verification and password reset) via Resend.
RESEND_API_KEY=
EMAIL_FROM="IELTS Practice Studio <no-reply@example.com>"
# Set to "console" to log emails instead of sending them (local dev / CI only).
# EMAIL_TRANSPORT=console

# --- AI ---------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com). Without it, Listening
# and Reading work normally and AI scoring reports "temporarily unavailable".
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash-lite).
# GEMINI_MODEL=

# --- Scaling and networking -------------------------------------------------

# Rate limiting store. "memory" is correct for a single server or container;
# serverless or multi-instance deployments must use Upstash Redis.
# RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Number of trusted reverse proxies in front of the app (default 1, which is
# correct for Vercel and a single nginx/Caddy). Or name one trusted header:
# TRUST_PROXY_HOPS=1
# CLIENT_IP_HEADER=cf-connecting-ip

# Extra origins allowed to make authenticated requests (custom domains, previews).
# ALLOWED_ORIGINS=https://www.example.com

# --- Google sign-in (optional; the button only appears when both are set) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorised JavaScript origin: http://localhost:3000   (and your real domain later)
#   Authorised redirect URI:      http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin ---
# Emails allowed to open /admin (payments review, revenue, manual Pro). Comma-separated.
ADMIN_EMAILS=

# --- Payments: SSLCommerz (bKash, Nagad, Rocket, Visa/Mastercard/Amex) ---

# Get free sandbox credentials from the SSLCommerz developer portal (developer.sslcommerz.com).
# Leave empty to hide checkout ("payments are being set up").
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "sandbox" for testing, "live" once SSLCommerz approves your merchant account.
SSLCOMMERZ_MODE=sandbox
# In the SSLCommerz merchant panel, set the IPN URL to:
#   https://your-domain.com/api/billing/sslcommerz/ipn

# --- Monitoring (optional) --------------------------------------------------

# Sentry stays fully disabled until a DSN is set.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Development only -------------------------------------------------------

# Phones/laptops on your Wi-Fi can already open the dev server's "Network" URL
# (any 192.168.x.x / 10.x.x.x / 172.16-31.x.x address). Add other hostnames here:
# DEV_ALLOWED_ORIGINS=my-tunnel.example.com
